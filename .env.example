# Copie para .env antes de subir os servicos: cp .env.example .env

# ---- Banco de dados ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=challenge
# Porta do Postgres no host; troque se a 5432 já estiver em uso
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge?schema=public

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tech-challenge
KAFKA_GROUP_ID_TRANSACTIONS=transactions-consumer
KAFKA_GROUP_ID_ANTI_FRAUD=anti-fraud-consumer

# ---- Portas das aplicacoes ----
TRANSACTIONS_PORT=3001
ANTI_FRAUD_PORT=3002

# Origem do dashboard autorizada a chamar a API (CORS)
WEB_ORIGIN=http://localhost:3000

# ---- Frontend ----
# Endereço da API usado pelo servidor do Next (o navegador fala só com o Next, via /api)
TRANSACTIONS_API_URL=http://localhost:3001
WEB_PORT=3000
